# Terraform
infrastructure/.terraform/
infrastructure/**/.terraform/
infrastructure/*.tfstate
infrastructure/*.tfstate.backup
infrastructure/.terraform.lock.hcl
# Subdirectory terraform state files (the top-level globs above do not match these).
# Real state belongs in a remote backend (azurerm/azure backend), not in git.
infrastructure/*/terraform.tfstate
infrastructure/*/terraform.tfstate.backup

# Environment files with secrets
infrastructure/env
*.env

# Python
__pycache__/
*.pyc
.venv/

# Nix
result
# .build/ is the nix build output directory (e.g. zip packages under
# .build/functions). Re-created on demand by `nix build`.
.build/

# subagent/ holds session-scoped subagent working directories
# (plan drafts, worker scratchpads, reviewer notes). Not part of the
# project — re-created by pi-subagents on demand.
subagent/

# Stray uv artifact. The project does not use uv: the top-level
# pyproject.toml is ruff configuration only and the service packages
# are built via nix + a service-local pyproject.toml. If a future
# change introduces uv for real, drop this line and commit uv.lock.
uv.lock
